# ── Axis environment ──────────────────────────────────────────────
# Copy to .env and fill in. Everything optional degrades gracefully:
# with no credentials, Axis runs on the stub delivery provider and
# logs sends instead of calling real APIs — so you can develop and
# demo the whole conversation with nothing configured.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── WhatsApp Cloud API ────────────────────────────────────────────
# From Meta / Facebook Developers > your app > WhatsApp > API Setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# You choose this string; enter the same value in the webhook config.
WHATSAPP_VERIFY_TOKEN=axis-verify
# App secret, used to verify inbound webhook signatures.
WHATSAPP_APP_SECRET=

# ── Telegram Bot API (free; good second channel) ──────────────────
# From @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=

# ── Glovo (Business / LaaS API) ───────────────────────────────────
# Sandbox base: https://api.testglovoapp.com  (confirm when issued creds)
# Prod base:    https://api.glovoapp.com
GLOVO_API_BASE=https://api.glovoapp.com
GLOVO_API_KEY=
GLOVO_API_SECRET=

# ── Affiliate tags (revenue with no API/partnership) ──────────────
JUMIA_AFFILIATE_TAG=
ORAIMO_AFFILIATE_TAG=

# ── Take rate ─────────────────────────────────────────────────────
# Basis points added to the order subtotal. 150 = 1.5%.
AXIS_FEE_BPS=150
# Flat fee per order, in kobo. 1000 = ₦10. Default 0.
AXIS_FEE_FLAT_KOBO=0

# ── Recognition model (optional) ──────────────────────────────────
# OpenAI-compatible endpoint. Leave unset to use the free rule-based
# recognizer. Works with Gemini's OpenAI-compat endpoint, a Claude
# gateway, or a local Ollama server.
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:  http://localhost:11434/v1
RECOGNITION_BASE_URL=
RECOGNITION_API_KEY=
RECOGNITION_MODEL=gemini-1.5-flash
