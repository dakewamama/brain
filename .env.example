# Axis MCP entrypoint. Export these with your shell or process manager.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Required for MCP. No in-memory production fallback.
DATABASE_URL=
# Required for real database validation; use a disposable database.
TEST_DATABASE_URL=
MCP_HOST=127.0.0.1
# Required for external binding; production requires an HTTPS origin.
MCP_PUBLIC_ORIGIN=
CASE_WORKER_POLL_MS=5000
# JSON array, at most one explicitly allowed upstream. See docs/MCP-SETUP.md.
AXIS_UPSTREAM_MCP=[]
# Remote upstream credentials are referenced by tokenEnv, never in URLs.

# Existing custody provider. Explicit mode required: LIVE or SANDBOX.
# Without configuration, balance and airtime are UNAVAILABLE.
# LIVE enables balance only. Airtime requires SANDBOX until custody debit bounds exist.
ONBOARDING_URL=
INTERNAL_API_TOKEN=
AXIS_ONBOARDING_MODE=
# Optional approved Photon /api endpoint. No implicit public-service traffic.
AXIS_PHOTON_URL=
# Optional shopping search. Results are observations, not merchant quotes.
SERPER_API_KEY=
SERPER_SHOPPING_URL=https://google.serper.dev/shopping

# Legacy conversational entrypoint only (not mounted by npm start).
# Preserve existing deployments; no new channel work is part of this milestone.
ADMIN_TOKEN=
WEB_WEBHOOK_TOKEN=
WEB_ORIGIN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PROFILE_STORE_DIR=
MCP_SERVERS=
MODEL_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
MAX_TRANSACTION_NGN=50000
CONFIRM_THRESHOLD_NGN=20000
RECONCILE_POLL_MS=30000

# PAJ v2, independent of the airtime/custody mode. See docs/PAJ.md.
PAJ_API_KEY=
PAJ_ENV=
PAJ_MINT=
PAJ_WEBHOOK_SECRET=
PAJ_WEBHOOK_ORIGIN=
# Enable ramp.on/ramp.off only after authenticated provider-contract validation.
PAJ_ENABLED_CAPABILITIES=ramp.quote,bank.resolve,ramp.status
