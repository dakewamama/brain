{
  "name": "axis",
  "version": "0.1.0",
  "description": "Policy-bounded MCP-native durable execution runtime",
  "type": "module",
  "main": "dist/mcp/main.js",
  "scripts": {
    "dev": "tsx watch src/mcp/main.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/mcp/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/cases/*.test.ts tests/gateway/*.test.ts",
    "console": "tsx src/console.ts",
    "eval:planner": "tsx src/eval/run.ts",
    "admin": "tsx src/mcp/admin.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "legacy:dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "whatsapp",
    "commerce",
    "nigeria",
    "conversational",
    "solana"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "express": "^4.21.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
